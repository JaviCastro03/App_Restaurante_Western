# ═══════════════════════════════════════════════════════════════
# EL ÚLTIMO CORRAL — Apache Configuration
# ═══════════════════════════════════════════════════════════════

Options -Indexes
ServerSignature Off

# ── Charset ────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── GZIP Compression ───────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE text/xml application/xml text/plain
</IfModule>

# ── Browser Caching ────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png            "access plus 1 year"
    ExpiresByType image/jpeg           "access plus 1 year"
    ExpiresByType image/svg+xml        "access plus 1 year"
    ExpiresByType font/woff2           "access plus 1 year"
</IfModule>

# ── Security Headers ────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Cache-Control "no-store, no-cache, must-revalidate" env=no_cache
</IfModule>

# ── Protect sensitive files ─────────────────────────────────────
<FilesMatch "\.(sql|log|env|json|lock|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Protect vendor and models ───────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to PHP models
    RewriteRule ^models/.*\.php$ - [F,L]

# Block direct access to controllers except api and verificar
RewriteRule ^controllers/(?!api/|verificar/).*\.php$ - [F,L]
</IfModule>

# ── PHP Settings ────────────────────────────────────────────────
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
    php_value display_errors 0
    php_value log_errors 1
</IfModule>
